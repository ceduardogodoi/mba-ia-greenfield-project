    "/videos": {
      "post": {
        "description": "Creates the video as a draft with a unique slug and opens a multipart upload in the object storage. The file bytes are sent directly to the storage through presigned part URLs (see POST /videos/{id}/upload/parts); they never pass through the API.",
        "operationId": "VideosController_initiateUpload",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitiateUploadDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Video pre-registered as draft; multipart upload started",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "slug": {
                      "type": "string",
                      "example": "dQw4w9WgXcQ"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "draft"
                      ]
                    },
                    "upload": {
                      "type": "object",
                      "properties": {
                        "partSize": {
                          "type": "integer",
                          "example": 67108864
                        },
                        "partCount": {
                          "type": "integer",
                          "example": 3
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "The authenticated user has no channel (CHANNEL_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Pre-register a video and start its upload",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{id}/upload/parts": {
      "post": {
        "description": "Returns short-lived (1 hour) presigned URLs to PUT each requested part directly to the object storage. The client reads the ETag response header of each part upload.",
        "operationId": "VideosController_signUploadParts",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUploadPartsDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Presigned part URLs",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "parts": {
                      "type": "array",
                      "items": {
                        "properties": {
                          "partNumber": {
                            "type": "integer"
                          },
                          "url": {
                            "type": "string",
                            "format": "uri"
                          }
                        }
                      }
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation failed, or a part number exceeds the part count (INVALID_PART_NUMBER)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Video not found (VIDEO_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Upload already completed (VIDEO_NOT_DRAFT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Sign upload part URLs",
        "tags": [
          "videos"
        ]
      },
      "get": {
        "description": "Lists the parts already stored for the pending multipart upload, so an interrupted upload can resume by re-sending only the missing parts.",
        "operationId": "VideosController_listUploadedParts",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Upload progress",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "partSize": {
                      "type": "integer"
                    },
                    "partCount": {
                      "type": "integer"
                    },
                    "uploadedParts": {
                      "type": "array",
                      "items": {
                        "properties": {
                          "partNumber": {
                            "type": "integer"
                          },
                          "sizeBytes": {
                            "type": "integer"
                          },
                          "etag": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid video id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Video not found (VIDEO_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Upload already completed (VIDEO_NOT_DRAFT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "List uploaded parts",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{id}/upload/complete": {
      "post": {
        "description": "Completes the multipart upload server-side (parts are listed from the storage), checks that all parts are present and match the declared size, moves the video to processing and enqueues the processing job.",
        "operationId": "VideosController_completeUpload",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Upload completed; processing enqueued",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "processing"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid video id, missing parts (UPLOAD_INCOMPLETE) or size mismatch (UPLOAD_SIZE_MISMATCH)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Video not found (VIDEO_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Upload already completed (VIDEO_NOT_DRAFT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Complete the upload and start processing",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{id}": {
      "get": {
        "description": "Returns the lifecycle status (draft → processing → ready | failed), the processing result (duration, metadata, failure reason) and a short-lived thumbnail URL.",
        "operationId": "VideosController_getVideo",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Video",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid video id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Video not found (VIDEO_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Get a video owned by the caller",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{slug}/stream": {
      "get": {
        "description": "Redirects (302) to a short-lived presigned URL of the original file. The object storage serves Range requests with 206 Partial Content, so playback starts without downloading the whole file. Owner-only in this phase.",
        "operationId": "VideosController_stream",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the presigned streaming URL (Location header)"
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Video not found (VIDEO_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Video is not ready (VIDEO_NOT_READY)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Stream a ready video",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{slug}/download": {
      "get": {
        "description": "Redirects (302) to a short-lived presigned URL that serves the original file as an attachment with its original file name. Owner-only in this phase.",
        "operationId": "VideosController_download",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the presigned download URL (Location header)"
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Video not found (VIDEO_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Video is not ready (VIDEO_NOT_READY)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Download a ready video",
        "tags": [
          "videos"
        ]
      }
    }
  },
  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "InitiateUploadDto": {
        "type": "object",
        "properties": {
          "fileName": {
            "type": "string",
            "example": "aula.mp4",
            "minLength": 1,
            "maxLength": 255
          },
          "sizeBytes": {
            "type": "number",
            "example": 150000000,
            "minimum": 1,
            "maximum": 10737418240,
            "description": "Declared file size in bytes (max 10 GiB)"
          },
          "contentType": {
            "type": "string",
            "enum": [
              "video/mp4",
              "video/quicktime",
              "video/webm",
              "video/x-matroska"
            ],
            "example": "video/mp4"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Defaults to the file name without its extension"
          }
        },
        "required": [
          "fileName",
          "sizeBytes",
          "contentType"
        ]
      },
      "SignUploadPartsDto": {
        "type": "object",
        "properties": {
          "partNumbers": {
            "example": [
              1,
              2
            ],
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "description": "Part numbers to sign (1-based, unique)",
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "partNumbers"
        ]
      },
      "VideoStatus": {
        "type": "string",
        "enum": [
          "draft",
          "processing",
          "ready",
          "failed"
        ]
      },
      "VideoStreamMetadataDto": {
        "type": "object",
        "properties": {
          "codec": {
            "type": "string",
            "nullable": true,
            "example": "h264"
          },
          "width": {
            "type": "number",
            "nullable": true,
            "example": 1920
          },
          "height": {
            "type": "number",
            "nullable": true,
            "example": 1080
          },
          "fps": {
            "type": "number",
            "nullable": true,
            "example": 25
          }
        },
        "required": [
          "codec",
          "width",
          "height",
          "fps"
        ]
      },
      "AudioStreamMetadataDto": {
        "type": "object",
        "properties": {
          "codec": {
            "type": "string",
            "nullable": true,
            "example": "aac"
          }
        },
        "required": [
          "codec"
        ]
      },
      "VideoMetadataDto": {
        "type": "object",
        "properties": {
          "formatName": {
            "type": "string",
            "nullable": true,
            "example": "mov,mp4,m4a,3gp,3g2,mj2"
          },
          "bitRate": {
            "type": "number",
            "nullable": true
          },
          "sizeBytes": {
            "type": "number",
            "nullable": true
          },
          "video": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoStreamMetadataDto"
              }
            ]
          },
          "audio": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/AudioStreamMetadataDto"
              }
            ]
          }
        },
        "required": [
          "formatName",
          "bitRate",
          "sizeBytes",
          "video",
          "audio"
        ]
      },
      "VideoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "example": "dQw4w9WgXcQ"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoStatus"
              }
            ]
          },
          "originalFilename": {
            "type": "string"
          },
          "contentType": {
            "type": "string",
            "example": "video/mp4"
          },
          "sizeBytes": {
            "type": "number"
          },
          "durationSeconds": {
            "type": "number",
            "nullable": true
          },
          "metadata": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoMetadataDto"
              }
            ]
          },
          "failureReason": {
            "type": "string",
            "nullable": true
          },
          "thumbnailUrl": {
            "type": "string",
            "nullable": true,
            "description": "Presigned GET URL of the thumbnail, valid for 1 hour"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "status",
          "originalFilename",
          "contentType",
          "sizeBytes",
          "durationSeconds",
          "metadata",
          "failureReason",
          "thumbnailUrl",
          "createdAt",
          "updatedAt"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}